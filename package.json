{
  "name": "darb",
  "version": "0.1.0",
  "private": true,
  "description": "Turn long YouTube videos into structured, trackable daily courses.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KhalidRouissi1/darb-youtube.git"
  },
  "bugs": {
    "url": "https://github.com/KhalidRouissi1/darb-youtube/issues"
  },
  "homepage": "https://github.com/KhalidRouissi1/darb-youtube#readme",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --sources",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@wxt-dev/module-react": "1.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wxt": "0.20.27"
  },
  "overrides": {
    "@vitejs/plugin-react": "5.2.0",
    "adm-zip": "0.6.1",
    "brace-expansion": "1.1.18",
    "esbuild": "0.28.1",
    "nanoid": "3.3.18",
    "shell-quote": "1.10.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
